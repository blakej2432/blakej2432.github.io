<!-- 전체 글 수 계산 -->
{% assign sum = site.posts | size %}

<nav class="nav__list">
  <input id="ac-toc" name="accordion-toc" type="checkbox" />
  <label for="ac-toc">{{ site.data.ui-text[site.locale].menu_label }}</label>
  <ul class="nav__items" id="category_tag_menu">
    <li>
      📂 <span class="nav__main-title">전체</span> <span><b>{{ sum }}</b></span> <span>개</span>
    </li>
    <hr class="section-divider">
    {% for main_cat in site.data.categories %}
    <li>
      <span class="nav__sub-title">| {{ main_cat[0] }} |</span>
      <ul class="sub-title-text">
        {% for sub_cat in main_cat[1] %}
          {% assign cat_id = sub_cat.id %}
          {% assign cat_label = sub_cat.label %}
          <li>
            <a href="/categories/{{ cat_id }}">
              {{ cat_label }}
              (
                {% if site.categories[cat_id] %}
                  {{ site.categories[cat_id].size }}
                {% else %}
                  0
                {% endif %}
              )
            </a>
          </li>
        {% endfor %}
      </ul>
      <hr class="section-divider">
    </li>
  {% endfor %}
  </ul>
</nav>